import "std:serve"

import "./vault.osl"
import "./api.osl"

*serve.Router r = serve.new()
r.use(serve.logger())

r.views("templates")
r.static("/static", "./static")

r.get("/{$}", homePage)
r.get("/auth", authPage)
// Old bookmarks and installed copies of the app open these.
for page in ["/unlock", "/setup", "/logout"] (
    r.get(page, redirectHome)
)

*serve.Router api = r.group("/api")
api.get("/health", def(*serve.Context c) -> (
    c.json(200, { ok: true })
))
api.post("/auth", handleAuth)
api.post("/logout", handleLogout)
api.get("/vault", requireToken, handleGetVault)
api.post("/setup", requireToken, handleSetup)
api.post("/entry", requireToken, handleSaveEntry)
api.post("/entries", requireToken, handleImportEntries)
api.delete("/entry", requireToken, handleDeleteEntry)

r.run(":5619")
